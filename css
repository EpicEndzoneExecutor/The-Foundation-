/* main.css */
/* Styles for the website */

/* Body properties */
body {
    /* Set the background color */
    background-color: #e6f7ff; /* Light blue background */
    /* Set the text color */
    color: #333333; /* Dark gray text */
}

/* Header properties */
header {
    /* Center align text in the header */
    text-align: center;
}

/* Navigation properties */
nav {
    /* Set the height of the navigation area */
    height: 600px;
    /* Set the width of the navigation area */
    width: 200px;
    /* Float the navigation to the left */
    float: left;
    /* Set padding inside the navigation area */
    padding: 5px;
    /* Set the line height */
    line-height: 30px;
}

/* Footer properties */
footer {
    /* Center align text in the footer */
    text-align: center;
    /* Set right margin */
    margin-right: 200px;
}

/* Meme Image properties */
